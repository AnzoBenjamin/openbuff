{
  "name": "@codebuff/scripts",
  "version": "1.0.0",
  "description": "Scripts package for Codebuff",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "guard:byok-wording": "bun run byok-wording-guard.ts",
    "guard:dependency-provenance": "bun run dependency-provenance-guard.ts",
    "guard:types-declaration": "bun run types-declaration-guard.ts",
    "guard:memory-drift": "bun run memory-drift-guard.ts",
    "guard:project-root": "bun run project-root-guard.ts",
    "guard:sync-agent-config": "bun run sync-agent-config.ts",
    "guard:determinism": "bun run determinism-guard.ts",
    "guard:mock-module": "bun run mock-module-guard.ts",
    "guard:ci-local": "bun run check-ci-local.ts",
    "debug-log-subset": "bun run debug-log-subset.ts",
    "typecheck-all": "bun run typecheck-all.ts",
    "harness:lsp": "bun run harness-language-server.ts",
    "harness:repro": "bun run generate-minimal-repro.ts",
    "harness:mutation": "bun run run-mutation-gate.ts",
    "harness:classifier-smoke": "bun harness-smoke.mjs",
    "calibrate:openai-tokens": "bun run calibrate-openai-tokens.ts"
  },
  "sideEffects": false,
  "engines": {
    "bun": "1.3.5"
  },
  "//dependencies": "Only packages imported by shipped source belong here. Workspace-internal @codebuff/* imports resolve inside the repository.",
  "//devDependencies": "Maintainer-only tooling: fat-sdk-openrouter-example.ts imports the provider SDK, but nothing this private package ships does. The provenance and types-declaration guards import nothing but node: builtins, so a registry provider SDK must not sit in this package's runtime dependencies.",
  "dependencies": {
    "@codebuff/common": "workspace:*"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^1.0.19"
  }
}
