{
  "name": "@codebuff/evals",
  "version": "1.0.0",
  "description": "Evaluation scripts for Openbuff (buffbench and scenario evals)",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "test:memory-retention": "bun test memory-retention/scenario.test.ts",
    "gen-repo-eval": "bun run buffbench/gen-repo-eval.ts",
    "run-single-eval": "bun run buffbench/main-single-eval.ts",
    "run-buffbench": "bun run buffbench/main.ts",
    "main": "bun run buffbench/main.ts",
    "main-openbuff": "bun run buffbench/main-openbuff.ts",
    "run-buffbench-nightly": "bun run buffbench/main-nightly.ts --subset nightly",
    "run-buffbench-pr-subset": "bun run buffbench/main-nightly.ts --subset pr",
    "eval-gate": "bun run buffbench/regression-gate.ts",
    "trigger-buffbench": "bun run scripts/trigger-buffbench.ts",
    "harness:ablation": "bun run buffbench/run-coding-harness-ablation.ts",
    "harness:cross-model": "bun run buffbench/run-cross-model-experiment.ts"
  },
  "sideEffects": false,
  "engines": {
    "bun": "1.4.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.0.56",
    "@codebuff/code-map": "workspace:*",
    "@codebuff/common": "workspace:*",
    "@codebuff/internal": "workspace:*",
    "@codebuff/agent-runtime": "workspace:*",
    "@openbuff/sdk": "workspace:*",
    "@oclif/core": "^4.4.0",
    "@oclif/parser": "^3.8.17",
    "async": "^3.2.6",
    "diff": "^8.0.2",
    "p-limit": "^6.2.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/async": "^3.2.24"
  }
}
